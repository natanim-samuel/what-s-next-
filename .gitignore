# ==========================================
# WHAT IS NEXT - Git Ignore
# React + Vite + Node.js + PostgreSQL
# ==========================================


# ------------------------------
# Dependencies
# ------------------------------

frontend/node_modules/
backend/node_modules/
node_modules/


# ------------------------------
# Environment variables
# ------------------------------

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

backend/.env
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local


# ------------------------------
# React / Vite build files
# ------------------------------

frontend/dist/
frontend/.vite/


# ------------------------------
# Node.js build files
# ------------------------------

backend/dist/
backend/build/


# ------------------------------
# Logs
# ------------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------
# Coverage
# ------------------------------

coverage/
.nyc_output/


# ------------------------------
# Cache
# ------------------------------

.cache/
.parcel-cache/
.eslintcache


# ------------------------------
# VS Code
# ------------------------------

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# ------------------------------
# IntelliJ / Android Studio
# ------------------------------

.idea/
*.iml


# ------------------------------
# Operating system files
# ------------------------------

.DS_Store
.DS_Store?
Thumbs.db
desktop.ini


# ------------------------------
# Temporary files
# ------------------------------

*.tmp
*.temp
*.swp
*.swo


# ------------------------------
# PostgreSQL local files
# ------------------------------

*.sql~
*.dump
*.backup